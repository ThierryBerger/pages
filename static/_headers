# Cloudflare Pages custom response headers.
# https://developers.cloudflare.com/pages/configuration/headers/

# Marimo WASM apps load Pyodide (Python runtime) dynamically from jsDelivr CDN.
# The default CSP blocks external module loading and blob: workers, breaking Pyodide.
# connect-src also needs PyPI (files.pythonhosted.org) for micropip package installs.
/research/company/*
  Content-Security-Policy: default-src 'self' cdn.jsdelivr.net; script-src 'self' 'unsafe-eval' 'unsafe-inline' cdn.jsdelivr.net blob:; worker-src blob: 'self'; connect-src 'self' cdn.jsdelivr.net files.pythonhosted.org pypi.org; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:
